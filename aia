#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
IMAGE="${OPENCODE_IMAGE:-opencode-agent}"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/opencode"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/opencode"

# Ensure host directories exist before mounting
mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$STATE_DIR"

if ! podman image exists "$IMAGE"; then
  printf 'Image %s not found; building from %s/Containerfile...\n' "$IMAGE" "$SCRIPT_DIR" >&2
  podman build -t "$IMAGE" -f "$SCRIPT_DIR/Containerfile" "$SCRIPT_DIR"
fi

ENTRYPOINT=opencode
if [ "$#" -gt 0 ]; then
  ENTRYPOINT="$1"
  shift
fi

exec podman run --rm -it \
  --entrypoint "$ENTRYPOINT" \
  --userns=keep-id:uid=1000,gid=1000 \
  -v "$PWD:$PWD:Z" \
  -v "$CONFIG_DIR:/home/agent/.config/opencode:z" \
  -v "$DATA_DIR:/home/agent/.local/share/opencode:z" \
  -v "$STATE_DIR:/home/agent/.local/state/opencode:z" \
  -w "$PWD" \
  -e TERM \
  -e COLORTERM \
  -e ANTHROPIC_API_KEY \
  -e OPENAI_API_KEY \
  -e GEMINI_API_KEY \
  "$IMAGE" "$@"
